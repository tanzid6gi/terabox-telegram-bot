# Put this in Railway Variables, not in GitHub.
# Simple format: the ndus cookie value only.
COOKIE_JSON=replace_with_your_ndus_cookie

# Or use a JSON object:
# COOKIE_JSON={"ndus":"replace_with_your_ndus_cookie","lang":"en"}

HTTP_MAX_RETRIES=3
HTTP_INITIAL_DELAY=0.5
HTTP_BACKOFF_FACTOR=2.0
RATE_LIMIT=10
RATE_WINDOW=60
CACHE_TTL=60
CACHE_MAX_SIZE=100
